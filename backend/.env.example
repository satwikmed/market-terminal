# --- AI layer (optional) -----------------------------------------------------
# Without a key the app still works: filing text comes straight from SEC EDGAR
# and move explanations fall back to a deterministic evidence summary.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
AI_PROVIDER=auto

# --- Data sources ------------------------------------------------------------
# SEC EDGAR requires a descriptive User-Agent with a working contact address.
# Requests without one are rejected with HTTP 403.
SEC_USER_AGENT=Your Name (personal project) you@example.com
# Optional: FRED works through public CSV feeds without a key.
FRED_API_KEY=
NEWS_API_KEY=

# --- Runtime -----------------------------------------------------------------
DEMO_MODE=false
DATABASE_URL=sqlite+aiosqlite:///./plain_english.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional regex for preview deployments, e.g. https://.*\.vercel\.app
CORS_ORIGIN_REGEX=

# --- Background refresh ------------------------------------------------------
ENABLE_SCHEDULER=true
QUOTE_REFRESH_MINUTES=10
# Set false to skip the (slow) full market pull on boot.
STARTUP_REFRESH=true
